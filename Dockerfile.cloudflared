# Multi-stage: copy the cloudflared binary from the official image into Alpine
# so we have sh + tee available to redirect all output to a log file.
# This lets tunnel_notifier watch the log without needing docker.sock.
FROM cloudflare/cloudflared:latest AS cf
FROM alpine:3.19

COPY --from=cf /usr/local/bin/cloudflared /usr/local/bin/cloudflared

# cloudflared needs ca-certificates for TLS to Cloudflare edge
RUN apk add --no-cache ca-certificates

RUN mkdir -p /var/log/cloudflared
