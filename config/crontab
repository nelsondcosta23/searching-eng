# Job search scraping system crontab
# Format: minute hour day month day_of_week command
#
# Multi-user strategy: orchestrator auto-detects ALL active users from
# users_perfil and processes them in sequence. No TARGET_USER_ID needed.
# New users are picked up automatically on the next run.
#
# Tiered scraping: Sapo+LinkedIn (best) → Companies+ITJobs → Indeed+Landing+Expresso
# Early exit: if MIN_TIER_YIELD (default 5) new jobs found, lower tiers are skipped.
#
# Random timing: --jitter 45 sleeps 0–45 min before starting, so each run
# happens at an unpredictable time within its 4-hour window.

# ── Log rotation at 23:58 ─────────────────────────────────────────────────────
58 23 * * * root truncate -s 0 /app/logs/scraper.log /app/logs/verifier.log 2>/dev/null || true

# ── Orchestrator: every 4 hours, randomised within a 45-min window ────────────
# Window centres: 01:00, 05:00, 09:00, 13:00, 17:00, 21:00
# Actual run time: window_start + random(0–45 min)
0 1,5,9,13,17,21 * * * root cd /app && /usr/local/bin/python /app/automation/orchestrator.py --jitter 45 >> /app/logs/scraper.log 2>&1

# ── Intra-day scorer: score new jobs that arrived via API without a full run ───
# Runs at :30 past the hour on non-orchestrator hours (avoids WAL contention).
30 3,7,11,15,19,23 * * * root cd /app && /usr/local/bin/python /app/automation/job_scorer.py >> /app/logs/scraper.log 2>&1

# ── Daily Email at 13:45 (after the 13:00 orchestrator window closes) ─────────
45 13 * * * root cd /app && /usr/local/bin/python /app/automation/send_email.py >> /app/logs/scraper.log 2>&1

# ── Weekly cleanup at Sunday 03:30 ────────────────────────────────────────────
30 3 * * 0 root cd /app && /usr/local/bin/python /app/automation/clean_jobs.py >> /app/logs/scraper.log 2>&1

# ── Weekly SQLite backup at Sunday 02:00 ──────────────────────────────────────
0 2 * * 0 root cd /app && /usr/local/bin/python /app/automation/backup_db.py >> /app/logs/scraper.log 2>&1

