{
  "title": "Searching-Eng — Scraper Health",
  "uid": "searching-eng-health",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Jobs Scraped (last 24h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "expr": "increase(searching_eng_jobs_scraped_total[24h])",
        "legendFormat": "{{platform}}"
      }]
    },
    {
      "id": 2,
      "title": "Active Jobs in DB",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "expr": "sum(searching_eng_jobs_active)",
        "legendFormat": "Total active"
      }]
    },
    {
      "id": 3,
      "title": "API Requests / min",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{
        "expr": "rate(searching_eng_api_requests_total[1m]) * 60",
        "legendFormat": "{{endpoint}} {{status}}"
      }]
    },
    {
      "id": 4,
      "title": "Scrape Duration (p95)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(searching_eng_scrape_duration_seconds_bucket[1h]))",
        "legendFormat": "p95 {{platform}}"
      }]
    },
    {
      "id": 5,
      "title": "API Errors / min",
      "type": "graph",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "targets": [{
        "expr": "rate(searching_eng_api_errors_total[1m]) * 60",
        "legendFormat": "{{endpoint}}"
      }]
    }
  ]
}
