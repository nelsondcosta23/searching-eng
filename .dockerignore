# =======================================================
# Git e controlo de versão
.git/
.gitignore
.gitattributes

# Python bytecode
__pycache__/
*.pyc
*.pyo
venv/

# Base de dados (montada via volume em docker-compose)
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
database/backups/
database/user_locks/
database/orchestrator.lock

# Logs e debug (montados via volume)
logs/
*.log
*_error*.html
*_error*.png
*_debug*.png
tmp/
scratch/

# Configuração sensível (injectada via env_file)
.env
.env.example

# Documentação (não necessária dentro do container)
README.md
INTEGRATION_GUIDE.md
CLAUDE.md
.claude/

# Docker — o compose e o Dockerfile principal não são precisos dentro da imagem
# Nota: Dockerfile.notifier NÃO está aqui — é necessário no build context do
# serviço tunnel_notifier (dockerfile: Dockerfile.notifier em docker-compose.yml).
Dockerfile
docker-compose.yml
.dockerignore

# IDE e ferramentas locais
.vscode/
.idea/
.gemini/
*.bat

# Scripts temporários e de debug
get_url.py
inspect_db.py
test_*.py
seed_*.py
fix_*.py
debug_*.py
