# =============================================================
# TEMPLATE DE CONFIGURAÇÕES (copiar para .env e preencher)
# =============================================================

# --- Base de Dados ---
DB_PATH=/app/database/vagas.db

# --- Email (Resend API) ---
RESEND_API_KEY=re_YOUR_KEY_HERE
EMAIL_DESTINO=teu_email@gmail.com
EMAIL_REMETENTE=vagas@resend.dev

# --- Configurações de Retenção ---
DIAS_RETENCAO=45

# --- Limite de Vagas por Plataforma (por execução) ---
# 0 = ilimitado (produção), >0 = limite por plataforma (teste)
MAX_JOBS_PER_PLATFORM=5

# --- API de Resultados ---
# Chave secreta para proteger o endpoint da API REST.
# O software externo deve enviar: Authorization: Bearer <API_KEY>
API_KEY=minha-chave-secreta-aqui

# Opcional: restringir POST /users/sync a um único user_id.
# Sem isto, qualquer holder da API_KEY pode fazer overwrite de qualquer perfil.
# Define apenas se a API serve um único utilizador final.
OWNER_USER_ID=

# Permitir callback URLs http:// (não https). Default: 0 = só https.
ALLOW_HTTP_CALLBACKS=0

# --- Verificação de Vagas Expiradas ---
VERIFIER_MAX_JOBS=0
VERIFIER_PAGE_TIMEOUT=15
VERIFIER_SLEEP_BETWEEN=2

# --- Webhook (Push de Resultados para Software Externo) ---
# Número máximo de vagas a enviar por webhook por utilizador (padrão: 5)
WEBHOOK_MAX_JOBS=5
# Chave secreta enviada no header X-Webhook-Secret de cada pedido
EXTERNAL_WEBHOOK_SECRET=whsec_gera_um_secret_aqui

# --- ITJobs API (https://www.itjobs.pt/api) ---
# Free, read-only API. Pede a tua key gratuitamente no link acima.
ITJOBS_API_KEY=
# Vagas por página (max 100 segundo a API)
ITJOBS_PAGE_LIMIT=50
# Limite de páginas por query (safety cap)
ITJOBS_MAX_PAGES=5
