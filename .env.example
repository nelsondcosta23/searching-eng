# =============================================================
# TECH JOB MARKET INTELLIGENCE TOOL — Template de Configuração
# =============================================================
# Copia este ficheiro para .env e preenche os valores marcados.
# Este ficheiro (.env.example) é seguro para commit — sem segredos reais.
# O .env real NÃO deve ser commitado (está no .gitignore).
# =============================================================


# --- ITJobs API (obrigatório) ---
# Regista em https://www.itjobs.pt/api para obter a tua chave.
# Sem esta chave o scraper ITJobs é ignorado na execução.
ITJOBS_API_KEY=A_TUA_CHAVE_ITJOBS_AQUI


# --- Limite de Vagas por Plataforma ---
# Máximo de NOVAS vagas a guardar por plataforma por execução.
# 0 = ilimitado (produção). Usa ex. 10 para testes rápidos.
MAX_JOBS_PER_PLATFORM=0


# --- ITJobs — Paginação ---
# Resultados por página da API ITJobs (máximo suportado: 50).
ITJOBS_PAGE_LIMIT=50
# Número máximo de páginas a consultar por execução do ITJobs.
ITJOBS_MAX_PAGES=5


# --- Landing.jobs — Paginação ---
# Número máximo de páginas a consultar por keyword no Landing.jobs.
LANDING_MAX_PAGES=5


# --- Verificador de Vagas Expiradas (job_verifier.py) ---
# Vagas scraped nos últimos N dias são ignoradas na verificação
# (se foram scraped há pouco, quase de certeza que ainda estão activas).
# Reduz chamadas HTTP redundantes. 0 = verificar todas sem excepção.
VERIFIER_SKIP_RECENT_DAYS=2

# Nº máximo de vagas a verificar por execução (0 = todas).
VERIFIER_MAX_JOBS=0

# Timeout em segundos para carregar cada página de vaga.
# NOTA: o job_verifier usa Selenium (undetected_chromedriver) para LinkedIn
# e Indeed, onde o bot-detection impede requests simples. Os scrapers de
# recolha (sapo, expresso, linkedin, itjobs, etc.) usam Playwright — são
# componentes distintos com configuração separada.
VERIFIER_PAGE_TIMEOUT=15

# Segundos de espera entre verificações consecutivas (evita sobrecarga nos sites).
VERIFIER_SLEEP_BETWEEN=2


# --- Base de Dados (opcional) ---
# Por omissão: <raiz_do_projecto>/database/vagas.db
# Descomenta e preenche para usar uma localização diferente (ex: Docker, CI).
# DB_PATH=/caminho/absoluto/para/vagas.db


# --- Perfil de Pesquisa (opcional) ---
# Por omissão: config/tech_profile.json (relativo à raiz do projecto).
# Descomenta para apontar para um ficheiro de perfil alternativo.
# TECH_PROFILE_CONFIG=/caminho/absoluto/para/tech_profile.json
