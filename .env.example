# =============================================================
# TEMPLATE DE CONFIGURAÇÕES (copiar para .env e preencher)
# =============================================================

# --- Base de Dados ---
DB_PATH=/app/database/vagas.db

# --- Observability (Phase 5) ---
# Sentry: create a project at sentry.io → Settings → Client Keys → DSN
# Leave empty to disable Sentry (zero overhead).
SENTRY_DSN=
SENTRY_ENV=production

# Grafana admin password (used when starting with --profile monitoring)
GRAFANA_ADMIN_PASSWORD=change_me_on_first_login

# --- PocketBase (user-facing DB) ---
# URL accessible by internal services (scraper container → pocketbase container).
PB_URL=http://pocketbase:8090
# Nota: o host externo (browser) acede em http://localhost:8091/_/
# (porta 8091 para não colidir com outros PocketBase a correr no mesmo host)
# Admin credentials created on first run via http://localhost:8090/_/
PB_ADMIN_EMAIL=admin@searching-eng.local
PB_ADMIN_PASSWORD=change_me_on_first_run

# --- Task Queue (Celery + Redis) ---
# Quando definido, o orchestrator usa Celery para correr utilizadores em paralelo.
# Omitir (ou deixar vazio) para modo directo/sequencial (default, sem Redis).
# REDIS_PASSWORD: deixar vazio desactiva autenticação Redis (não recomendado em produção).
# Gerar: python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=
# Com password, o URL muda para: redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- Email (Resend API) ---
RESEND_API_KEY=re_YOUR_KEY_HERE
EMAIL_DESTINO=teu_email@gmail.com
EMAIL_REMETENTE=vagas@resend.dev

# --- Configurações de Retenção ---
DIAS_RETENCAO=45

# --- Limite de Vagas por Plataforma (por execução) ---
# 0 = ilimitado (produção), >0 = limite por plataforma (teste)
MAX_JOBS_PER_PLATFORM=5

# --- API de Resultados ---
# Chave secreta para proteger o endpoint da API REST.
# O software externo deve enviar: Authorization: Bearer <API_KEY>
# OBRIGATÓRIO: substituir por um valor aleatório forte (mínimo 32 chars).
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA usar o valor de exemplo em produção.
API_KEY=minha-chave-secreta-aqui

# Swagger UI (/docs) e ReDoc (/redoc) — desactivados por omissão em produção.
# Activar apenas para desenvolvimento local: ENABLE_API_DOCS=1
ENABLE_API_DOCS=0

# Limite de falhas de autenticação por IP antes de 429 (janela: RATE_LIMIT_WINDOW segundos)
RATE_LIMIT_MAX_FAILS=10
RATE_LIMIT_WINDOW=60

# FORTEMENTE RECOMENDADO: restringir a API a um único user_id.
# Sem isto, qualquer holder da API_KEY pode ler/escrever dados de qualquer
# utilizador (incluindo GET /jobs/{id} por enumeração de IDs sequenciais).
# Define como o UUID do teu utilizador (campo user_id em users_perfil).
OWNER_USER_ID=

# Permitir callback URLs http:// (não https). Default: 0 = só https.
ALLOW_HTTP_CALLBACKS=0

# --- Verificação de Vagas Expiradas ---
VERIFIER_MAX_JOBS=0
VERIFIER_PAGE_TIMEOUT=15
VERIFIER_SLEEP_BETWEEN=2

# --- Webhook (Push de Resultados para Software Externo) ---
# Número máximo de vagas a enviar por webhook por utilizador (padrão: 5)
WEBHOOK_MAX_JOBS=5
# Chave secreta enviada no header X-Webhook-Secret de cada pedido
EXTERNAL_WEBHOOK_SECRET=whsec_gera_um_secret_aqui

# --- Cloudflare Tunnel Update Webhook ---
# Opcional: endereço do endpoint do Trakki para receber o novo URL do túnel.
# Se configurado, o notifier enviará um POST com {event: 'tunnel_updated', base_url: ...}.
TUNNEL_UPDATE_WEBHOOK_URL=
# Chave secreta enviada no header X-Webhook-Secret.
# Se não definido, o notifier usa EXTERNAL_WEBHOOK_SECRET como fallback.
TUNNEL_UPDATE_WEBHOOK_SECRET=
# Opcional: caminho para armazenar o último URL notificado e evitar duplicados.
# Padrão: tmp/last_tunnel_url.txt dentro da aplicação.
TUNNEL_UPDATE_STATE_PATH=

# --- ITJobs API (https://www.itjobs.pt/api) ---
# Free, read-only API. Pede a tua key gratuitamente no link acima.
ITJOBS_API_KEY=
# Vagas por página (max 100 segundo a API)
ITJOBS_PAGE_LIMIT=50
# Limite de páginas por query (safety cap)
ITJOBS_MAX_PAGES=5

# =============================================================================
# JOB PROFILES — Mapeamento de perfis para scrapers
# =============================================================================
#
# Como usar:
#   Enviar no campo "job_profile" do POST /api/v1/users/sync.
#   Valor desconhecido ou omitido → preserva valor existente na DB.
#   Primeiro utilizador sem histórico → usa "generalist" como fallback.
#   Consultar perfis disponíveis em runtime: GET /api/v1/profiles
#
# Scrapers disponíveis:
#   sapo_scraper.py      → Sapo Emprego (PT generalista)        ★★★★★ universal
#   linkedin_scraper.py  → LinkedIn PT (todas as áreas)          ★★★★★ universal
#   indeed_scraper.py    → Indeed PT (todas as áreas)            ★★★★  universal
#   expresso_scraper.py  → Expresso Emprego (PT generalista)     ★★★   universal
#   itjobs_scraper.py    → ITJobs (EXCLUSIVO IT/tech)            ★★★★  tech only
#   companies_scraper.py → 89 empresas tech via ATS APIs         ★★★★★ tech only
#   landing_scraper.py   → Landing.jobs (remote tech)            ★★    tech only
#
# =============================================================================

VALID_JOB_PROFILES=tech,data,design,engineering,marketing,hr,finance,sales,legal,hospitality,healthcare,education,logistics,construction,operations,retail,manufacturing,customer_service,admin,generalist

# tech — Software, IT, DevOps, Cloud, Cibersegurança, Produto Digital
#         Ideal: developer, CTO, tech lead, SRE, product manager tech
SCRAPERS_TECH=sapo_scraper.py,linkedin_scraper.py,companies_scraper.py,itjobs_scraper.py,indeed_scraper.py,landing_scraper.py,expresso_scraper.py

# data — Data Science, Analytics, BI, Machine Learning, AI Engineering
#         Ideal: data scientist, data engineer, ML engineer, BI analyst
SCRAPERS_DATA=sapo_scraper.py,linkedin_scraper.py,companies_scraper.py,itjobs_scraper.py,indeed_scraper.py,landing_scraper.py,expresso_scraper.py

# design — UX/UI, Product Design, Graphic Design, Motion, Brand
#           Ideal: UX designer, UI designer, product designer, diretor criativo
SCRAPERS_DESIGN=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# engineering — Engenharia Civil, Mecânica, Industrial, Electrotécnica
#               Ideal: engenheiro civil, mecânico, electrotécnico, qualidade
SCRAPERS_ENGINEERING=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# marketing — Marketing Digital, SEO, Redes Sociais, Comunicação, Branding
#             Ideal: marketing manager, growth, SEO, content, social media
SCRAPERS_MARKETING=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# hr — Recursos Humanos, Recrutamento, Talent Acquisition, L&D, HRBP
#       Ideal: HR manager, recruiter, talent acquisition, L&D, CHO
SCRAPERS_HR=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# finance — Contabilidade, Finanças, Auditoria, Controlo de Gestão, CFO
#           Ideal: contabilista, controller, CFO, auditor, analista financeiro
SCRAPERS_FINANCE=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# sales — Vendas, Business Development, Account Manager, Key Account
#          Ideal: sales manager, BDR, AE, key account, CCO, director comercial
SCRAPERS_SALES=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# legal — Direito, Compliance, Jurídico, RGPD, Contratos
#          Ideal: advogado, jurista, compliance officer, DPO, legal counsel
SCRAPERS_LEGAL=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# hospitality — Hotelaria, Restauração, Turismo, Cozinha, F&B, Eventos
#               Sapo + Expresso lideram para este sector em PT
#               Ideal: chef, cozinheiro, recepcionista, F&B manager
SCRAPERS_HOSPITALITY=sapo_scraper.py,expresso_scraper.py,indeed_scraper.py,linkedin_scraper.py

# healthcare — Medicina, Enfermagem, Farmácia, Fisioterapia, Saúde
#              Ideal: médico, enfermeiro, farmacêutico, fisioterapeuta
SCRAPERS_HEALTHCARE=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# education — Ensino, Formação, Coordenação Pedagógica, E-Learning
#             Ideal: professor, formador, coordenador pedagógico
SCRAPERS_EDUCATION=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# logistics — Supply Chain, Transportes, Armazém, Compras, Operações
#             Ideal: supply chain manager, logístico, comprador, armazém
SCRAPERS_LOGISTICS=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# construction — Construção, Obra, Arquitectura, Imobiliário, Real Estate
#                Sapo + Expresso mais fortes para construção PT
#                Ideal: arquitecto, gestor de obra, director técnico
SCRAPERS_CONSTRUCTION=sapo_scraper.py,expresso_scraper.py,linkedin_scraper.py,indeed_scraper.py

# operations — Operações, Project Management, PMO, Processos, COO, Lean
#              Ideal: COO, operations manager, project manager, PMO, lean
SCRAPERS_OPERATIONS=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# retail — Retalho, Loja, Merchandising, E-Commerce, Visual Merchandising
#           Sapo + Expresso lideram para retalho PT
#           Ideal: store manager, visual merchandiser, e-commerce manager
SCRAPERS_RETAIL=sapo_scraper.py,expresso_scraper.py,indeed_scraper.py,linkedin_scraper.py

# manufacturing — Produção Industrial, Qualidade, Lean, Manutenção, HST
#                 Sapo forte para indústria PT; Expresso bom para operacional
#                 Ideal: director produção, engenheiro qualidade, técnico manutenção
SCRAPERS_MANUFACTURING=sapo_scraper.py,expresso_scraper.py,linkedin_scraper.py,indeed_scraper.py

# customer_service — Apoio ao Cliente, Call Center, Customer Success, CX
#                    Sapo + Expresso têm o maior volume para apoio ao cliente PT
#                    Ideal: customer success, CX manager, apoio ao cliente
SCRAPERS_CUSTOMER_SERVICE=sapo_scraper.py,expresso_scraper.py,indeed_scraper.py,linkedin_scraper.py

# admin — Secretariado, Assistente Administrativo, Office Manager, Back-Office
#          Sapo + Expresso lideram para admin PT
#          Ideal: assistente administrativo, secretária, office manager
SCRAPERS_ADMIN=sapo_scraper.py,expresso_scraper.py,indeed_scraper.py,linkedin_scraper.py

# generalist — Fallback para perfis desconhecidos ou multi-área
#              Usado quando job_profile não é enviado (novo user sem histórico)
SCRAPERS_GENERALIST=sapo_scraper.py,linkedin_scraper.py,indeed_scraper.py,expresso_scraper.py

# Mínimo de novas vagas por tier antes de saltar para o tier seguinte
MIN_TIER_YIELD=5
